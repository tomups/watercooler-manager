#!/bin/sh
set -eu

launcher=$(readlink -f -- "$0")
app_dir=$(dirname -- "$launcher")
# Keep a persistent entry point rather than a temporary AppImage mount or
# Python interpreter. All arguments stay separate from shell program text.
WATERCOOLER_LAUNCHER=${APPIMAGE:-$launcher}
export WATERCOOLER_LAUNCHER

# AppIndicator exports icon file paths to the desktop tray host. Its private
# /tmp is invisible outside a sandbox, so use a persistent, host-visible path.
if [ -n "${FLATPAK_ID:-}" ]; then
    TMPDIR="$XDG_CACHE_HOME/watercooler-manager/tray"
elif [ -n "${SNAP:-}" ]; then
    # AppIndicator recognises GLib's cache/config/home paths. SNAP_USER_COMMON
    # is outside the revision's HOME and would be incorrectly prefixed with
    # $SNAP when exporting the absolute icon name to the desktop.
    XDG_CACHE_HOME="$SNAP_USER_DATA/.cache"
    TMPDIR="$XDG_CACHE_HOME/watercooler-manager/tray"
    XDG_CONFIG_HOME="$SNAP_USER_DATA/.config"
    export XDG_CONFIG_HOME XDG_CACHE_HOME
fi
if [ -n "${FLATPAK_ID:-}${SNAP:-}" ]; then
    mkdir -p -- "$TMPDIR"
    export TMPDIR
fi
exec "$app_dir/WaterCoolerManager" "$@"
